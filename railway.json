{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @watchman/agent build",
    "watchPatterns": [
      "/apps/agent/**",
      "/packages/db/**",
      "/packages/sdk/**",
      "/pnpm-lock.yaml",
      "/package.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @watchman/db exec prisma migrate deploy"],
    "startCommand": "pnpm --filter @watchman/agent start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
