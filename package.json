{
  "name": "watchman",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @watchman/web dev",
    "dev:agent": "pnpm --filter @watchman/agent dev",
    "build": "pnpm --filter @watchman/db generate && pnpm -r --filter=!@watchman/plugin build",
    "typecheck": "pnpm -r --filter=!@watchman/plugin typecheck",
    "test": "pnpm --filter @watchman/core test",
    "db:generate": "pnpm --filter @watchman/db generate",
    "db:migrate": "pnpm --filter @watchman/db migrate",
    "db:migrate:deploy": "pnpm --filter @watchman/db migrate:deploy"
  },
  "devDependencies": { "typescript": "^5.9.2" }
}
