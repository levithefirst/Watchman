generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Asset {
  BTC
  ETH
}

enum HedgeStatus {
  /** Intent recorded. Nothing has been sent on-chain yet. */
  QUOTED
  /**
   * An order HAS been sent on-chain and its outcome is not yet known. Money
   * may already have moved. A row left in this state is the recovery target:
   * it carries the wallet, market and requested size needed to reconcile
   * against the chain. It must never be interpreted as "did not execute".
   */
  EXECUTING
  OPEN
  ACTIVE
  SETTLING
  SETTLED
  REDEEMED
  FAILED
}

enum PolicyStatus {
  ACTIVE
  PAUSED
}

model User {
  id          String     @id @default(cuid())
  wallet      String     @unique
  demo        Boolean    @default(false)
  createdAt   DateTime   @default(now())
  exposures   Exposure[]
  hedges      Hedge[]
  policies    Policy[]
}

model Exposure {
  id          String   @id @default(cuid())
  userId      String
  asset       Asset
  amount      Decimal  @db.Decimal(30, 10)
  entryPrice  Decimal  @db.Decimal(30, 10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hedges      Hedge[]
  @@index([userId, asset])
}

model Hedge {
  id                 String      @id @default(cuid())
  userId             String
  exposureId         String?
  asset              Asset
  marketId           String
  marketSymbol       String
  windowSeconds      Int
  protectionPct      Decimal     @db.Decimal(8, 5)
  exposureUsd        Decimal     @db.Decimal(30, 10)
  protectedUsd       Decimal     @db.Decimal(30, 10)
  contractsRequested Decimal     @db.Decimal(30, 10)
  contractsFilled    Decimal     @db.Decimal(30, 10)
  premiumUsd         Decimal     @db.Decimal(30, 10)
  downPrice          Decimal     @db.Decimal(20, 10)
  txHash             String?
  redeemTxHash       String?
  /**
   * Client-supplied key for one protect attempt. Unique, so a retry whose
   * response was lost cannot execute a second on-chain order: the insert
   * loses the race and the existing hedge is returned instead.
   */
  idempotencyKey     String?     @unique
  /** When the order was sent on-chain. Set before execution, never cleared. */
  executionStartedAt DateTime?
  expiry             DateTime
  status             HedgeStatus @default(OPEN)
  createdAt          DateTime    @default(now())
  settledAt          DateTime?
  redeemedAt         DateTime?
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exposure           Exposure?   @relation(fields: [exposureId], references: [id], onDelete: SetNull)
  receipt            Receipt?
  @@index([userId, status])
  @@index([marketId])
}

model Receipt {
  id               String   @id @default(cuid())
  hedgeId          String   @unique
  exposureUsd      Decimal  @db.Decimal(30, 10)
  premiumUsd       Decimal  @db.Decimal(30, 10)
  actualMovePct    Decimal  @db.Decimal(20, 10)
  unhedgedPnlUsd   Decimal  @db.Decimal(30, 10)
  hedgedPnlUsd     Decimal  @db.Decimal(30, 10)
  payoutUsd        Decimal  @db.Decimal(30, 10)
  // Attribution. grossLossOffsetUsd is capped at the realised loss, so
  // lossOffsetPct is bounded at 100 by construction. netHedgeContributionUsd
  // (payout - premium) is deliberately a separate figure: it is what the hedge
  // added to the position, not how much loss it offset.
  grossLossOffsetUsd      Decimal @db.Decimal(30, 10)
  lossOffsetPct           Decimal @db.Decimal(20, 10)
  netHedgeContributionUsd Decimal @db.Decimal(30, 10)
  overshootUsd            Decimal @db.Decimal(30, 10)
  createdAt        DateTime @default(now())
  hedge            Hedge    @relation(fields: [hedgeId], references: [id], onDelete: Cascade)
}

model Policy {
  id            String       @id @default(cuid())
  userId        String
  asset         Asset
  protectionPct Decimal      @db.Decimal(8, 5)
  windowSeconds Int
  maxPremiumUsd Decimal      @db.Decimal(30, 10)
  status        PolicyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}
