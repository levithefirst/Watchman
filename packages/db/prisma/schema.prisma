generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  DEMO
  LIVE
}

enum ProtectionStatus {
  /// Compiled, not yet authorized. The only state in which terms may change.
  DRAFT
  /// Authorized and frozen. Watchman is monitoring the price.
  ARMED
  /// The trigger fired. See `stage` for exactly where the swap is.
  EXECUTING
  /// Verified on-chain (or, in demo mode, against the simulated ledger).
  COMPLETED
  FAILED
  REVOKED
}

enum ExecutionStage {
  SUBMITTING
  PENDING_APPROVAL
  PENDING_SIGNATURE
  PENDING_FUNDING
  SETTLING
  VERIFYING
  /// Watchman could not prove what happened and has stopped acting.
  NEEDS_REVIEW
}

/// One protective order. Field-for-field the engine's ProtectionRecord
/// (packages/core/src/model.ts). Every state change is a conditional UPDATE
/// guarded on the previous state, which is what makes execution idempotent.
model Protection {
  id          String           @id @default(cuid())
  /// Anonymous browser session that created it.
  ownerId     String
  mode        Mode
  status      ProtectionStatus @default(DRAFT)
  stage       ExecutionStage?
  instruction String
  dropBps     Int
  sellBps     Int

  payboxCredentialId   String?
  payboxCredentialName String?
  approvalMode         String?
  walletAddress        String?

  referencePriceCents Int?
  triggerPriceCents   Int?
  /// Wei, as a decimal string.
  balanceAtArmWei     String?
  maxSellWei          String?
  armedAt             DateTime?

  lastPriceCents      Int?
  lastPriceAt         DateTime?
  lastPriceSources    String?
  pauseReason         String?
  permissionCheckedAt DateTime?
  demoDropAt          DateTime?

  triggeredAt          DateTime?
  triggerObservedCents Int?
  sellWei              String?
  /// Set by the single caller that won the right to submit. Never cleared.
  submitStartedAt      DateTime?
  payboxRequestId      String?   @unique
  payboxStatus         String?
  approvalUrl          String?
  signAttemptedAt      DateTime?
  txHash               String?
  soldWei              String?
  /// USDC atomic units (6 decimals), as a decimal string.
  usdcReceived         String?
  executionPriceCents  Int?
  verifiedAt           DateTime?
  failureCode          String?
  failureMessage       String?
  fundsMoved           String?

  completedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events AuditEvent[]

  @@index([ownerId, createdAt])
  @@index([mode, status])
}

model AuditEvent {
  id           String     @id @default(cuid())
  protectionId String
  kind         String
  /// For one-shot kinds this equals `kind`, making the event idempotent;
  /// repeatable kinds (pause/resume) get a unique suffix.
  dedupeKey    String
  message      String
  priceCents   Int?
  amount       String?
  requestId    String?
  txHash       String?
  metadata     Json?
  at           DateTime   @default(now())
  protection   Protection @relation(fields: [protectionId], references: [id], onDelete: Cascade)

  @@unique([protectionId, dedupeKey])
  @@index([protectionId, at])
}

/// Liveness of the Railway monitor, so the UI can say when monitoring is interrupted.
model MonitorHeartbeat {
  id          String   @id
  seenAt      DateTime
  priceCents  Int?
  priceAt     DateTime?
  sources     String?
  canSign     Boolean  @default(false)
}
