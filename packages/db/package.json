{
  "name": "@watchman/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@watchman/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "typescript": "^5.9.2",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  }
}
