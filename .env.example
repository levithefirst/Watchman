# Watchman — Somnia Shannon testnet (chain 50312)
# Copy this file to .env (repo root) and fill in the values you need.
# apps/web and apps/agent both read these from process.env at runtime.

# --- Required ---

# Postgres connection string (Neon recommended). Both apps/web (reads/writes
# Exposure, Hedge, Receipt, Policy rows) and apps/agent (settlement loop)
# need this. Use the pooled connection string if your provider offers one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Real testnet execution (optional but recommended) ---

# Somnia Shannon testnet wallet private key. NEVER commit this.
# - Absent: the whole quote -> hedge -> settlement -> receipt pipeline still
#   runs, but orders are simulated (no on-chain transaction) and the UI shows
#   a "Simulated order" badge. This is the primary judge-facing demo path.
# - Present: apps/web executes real IOC orders on DreamDEX, and apps/agent
#   redeems resolved positions on-chain during settlement.
# Fund this wallet with testnet STT (gas) and tUSDC (collateral) before
# enabling real execution — use the in-app faucet button (dev only) or the
# Somnia Shannon faucet.
PRIVATE_KEY=0x...

# --- Agent tuning (optional) ---

# How often (ms) the Railway settlement/policy loop polls for hedges that
# need settling and active policies that need a hedge opened. Default 10000.
SETTLEMENT_POLL_MS=10000

# --- DreamDEX discovery overrides (optional, advanced) ---

# Restrict market discovery to a specific venue/operator. Leave blank to use
# the SDK defaults — most deployments never need to set these.
VENUE_ID=
OPERATOR_ID=

# --- Notes ---
# Chain id, RPC URL, indexer URL, price feed and contract addresses are
# fixed testnet constants in packages/sdk/src/config.ts, not env vars.
# Do not point this app at mainnet.
