# Watchman: one PayBox-scoped ETH protection on Base.
#
# Copy to .env for local development. In production set these in the Vercel
# (apps/web) and Railway (apps/agent) dashboards; see DEPLOY.md.
# Never commit real values.

# ------------------------------------------------------------------ both
# Postgres (Neon). The web app and the monitor must share one database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ------------------------------------------------------------------ PayBox
# Leave all PAYBOX_* unset to run demo mode only. Names are the ones the
# official @paybox-sh/sdk reads.
#
# PAYBOX_API_KEY: the Watchman agent's personal API key (pbx_live_...).
# Create it in the PayBox app under Agents and grant it one Base wallet.
# Needed on Vercel (to confirm the grant when arming) and Railway (to execute).
PAYBOX_API_KEY=
#
# PAYBOX_SIGNING_KEY: the agent signer paired to that same API key
# (pbxk1..., from `paybox login --key ...` then `paybox connect`). It is NOT a
# wallet private key; the wallet key stays in PayBox custody. Set it on
# Railway only. Without it, swaps stop at "Signature required" and the user
# finishes them in PayBox.
PAYBOX_SIGNING_KEY=
#
# Optional. Defaults to https://api.paybox.sh.
PAYBOX_API_URL=

# ------------------------------------------------------------------ live mode
# Live protections can only be armed from a browser unlocked at /operator
# with this key (12+ characters). Without it the site is demo-only even when
# PayBox is configured. Vercel only.
WATCHMAN_OPERATOR_KEY=

# ------------------------------------------------------------------ optional
# Base JSON-RPC used for balances and receipt verification.
# Defaults to https://mainnet.base.org.
BASE_RPC_URL=
# Monitor tick interval in ms (Railway). Default 5000, minimum 2000.
WATCHMAN_POLL_MS=5000
# Canonical site URL for metadata. Vercel's production URL is used if unset.
NEXT_PUBLIC_SITE_URL=
